{
  "name": "@fun-chess/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fun-chess/shared": "workspace:^1.0.0",
    "chess.js": "1.4.0",
    "pino": "9.6.0",
    "socket.io": "4.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.13.5",
    "socket.io-client": "4.8.1",
    "tsx": "4.19.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
