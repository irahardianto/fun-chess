# ==============================================================================
# Fun Chess Server Configuration
# ==============================================================================
# Copy this file to .env to configure your Fun Chess server instance.
# All environment variables are validated at startup via Zod.
# ==============================================================================

# Port to bind HTTP and WebSocket servers (number: 0 - 65535, default: 3000)
PORT=3000

# Network interface address to bind to (string, default: "0.0.0.0")
HOST=0.0.0.0

# Runtime environment (enum: "development" | "production" | "test", default: "development")
NODE_ENV=development

# Structured logging level (enum: "trace" | "debug" | "info" | "warn" | "error" | "fatal", default: "info")
LOG_LEVEL=info

# Reverse proxy trust (boolean: "true" | "false", default: false)
# When set to true, trusts X-Forwarded-For headers for client IP extraction & rate limiting behind reverse proxies/load balancers.
TRUST_PROXY=false

# Client application URL (valid URL)
# Primary URL where the frontend client is hosted. Used to derive allowed CORS origins if CORS_ORIGIN is omitted.
CLIENT_URL=http://localhost:5173

# Path to static client distribution directory for production HTTP asset serving
# Used by the HTTP server to serve frontend static bundles in containerized/unified deployments.
# Example: /app/apps/client/dist or ../client/dist
CLIENT_DIST_PATH=

# Allowed CORS origins (comma-separated list of origins)
# MANDATORY in production if PUBLIC_URL or CLIENT_URL is not set.
# Example: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Publicly reachable URL for Cloud Relay or reverse proxy deployment (valid URL)
# Used to construct room share links / QR codes and as a CORS origin fallback.
# Example: https://fun-chess-xyz.a.run.app
PUBLIC_URL=http://localhost:3000

# Optional explicit local LAN IP override for QR codes / local multiplayer
# If omitted, auto-detected from primary network interface.
# Example: 192.168.1.100
LAN_IP=

# Alias for LAN_IP (valid IPv4/IPv6 address)
HOST_IP=

# ------------------------------------------------------------------------------
# Security & Telemetry Configuration
# ------------------------------------------------------------------------------

# METRICS_SECRET: Shared secret token for protecting /metrics and /health/detail telemetry endpoints.
# When configured, callers must supply matching x-metrics-secret header or Bearer token (optional in development).
METRICS_SECRET=

# SESSION_SECRET: Secret key for signing session tokens.
SESSION_SECRET=

# ------------------------------------------------------------------------------
# In-Memory Storage & Capacity Limits
# ------------------------------------------------------------------------------

# MAX_ROOMS: Maximum allowed active rooms in in-memory store. (positive integer, default: 10000)
MAX_ROOMS=10000

# ------------------------------------------------------------------------------
# Rate Limiting Configuration (RATE_LIMIT_*)
# ------------------------------------------------------------------------------

# Rate limiting sliding window duration in milliseconds (positive integer, default: 10000 [10s])
RATE_LIMIT_WINDOW_MS=10000

# Maximum socket requests allowed per client IP within the sliding window (positive integer, default: 60 [60 req/10s])
RATE_LIMIT_MAX_REQUESTS=60

# RATE_LIMIT_ROOM_CREATE_MAX: Maximum room creation operations allowed within the rate limit window. (positive integer, default: 3)
RATE_LIMIT_ROOM_CREATE_MAX=3

# RATE_LIMIT_MAX_KEYS: Maximum tracked keys in the in-memory rate limiter cache. (positive integer, default: 10000)
RATE_LIMIT_MAX_KEYS=10000
