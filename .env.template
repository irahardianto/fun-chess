# ==============================================================================
# Fun Chess Server Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment.
# All variables are validated at startup via Zod in src/platform/config/env.ts.
# ==============================================================================

# Port to bind the HTTP and WebSocket server to (number: 0 - 65535, default: 3000)
PORT=3000

# Network interface address to bind to (string, default: "0.0.0.0")
HOST=0.0.0.0

# Runtime environment (enum: "development" | "production" | "test", default: "development")
NODE_ENV=development

# Structured logging level (enum: "trace" | "debug" | "info" | "warn" | "error" | "fatal", default: "info")
LOG_LEVEL=info

# Reverse proxy trust (boolean: "true" | "false", default: false)
# When set to true, trusts X-Forwarded-For headers for client IP extraction & rate limiting behind reverse proxies/load balancers.
TRUST_PROXY=false

# Client application URL (valid URL)
# Primary URL where the frontend client is hosted. Used to derive allowed CORS origins if CORS_ORIGIN is omitted.
# Example: http://localhost:5173 or https://chess.example.com
CLIENT_URL=

# Allowed origins for CORS in HTTP and Socket.IO (comma-separated list of origins)
# MANDATORY in production if PUBLIC_URL or CLIENT_URL is not set.
# Example: https://fun-chess.example.com,https://client.fun-chess.internal
# Default in development: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ORIGIN=

# Publicly reachable URL for Cloud Relay or reverse proxy deployment (valid URL)
# Used to construct join URLs and derive allowed CORS origins if CORS_ORIGIN is omitted.
# Example: https://fun-chess-xyz.a.run.app
PUBLIC_URL=

# Explicit local LAN IP override for room sharing QR codes (valid IPv4/IPv6 address)
# If omitted, auto-detected from primary network interface.
# Example: 192.168.1.100
LAN_IP=

# Alias for LAN_IP (valid IPv4/IPv6 address)
# Example: 192.168.1.100
HOST_IP=

# Explicit path to client dist directory for SPA static file serving
# In Docker production container, defaults to /app/apps/client/dist.
# If omitted, auto-resolved to ../client/dist relative to server.
# Example: /app/apps/client/dist
CLIENT_DIST_PATH=

# ------------------------------------------------------------------------------
# Rate Limiting Configuration (RATE_LIMIT_*)
# ------------------------------------------------------------------------------

# Rate limiting sliding window duration in milliseconds (positive integer, default: 10000 [10s])
RATE_LIMIT_WINDOW_MS=10000

# Maximum room creations allowed per client IP per minute (positive integer, default: 3 [MIN-001])
RATE_LIMIT_ROOM_CREATE_MAX=3

# Maximum socket requests allowed per client IP within the sliding window (positive integer, default: 60 [60 req/10s])
RATE_LIMIT_MAX_REQUESTS=60

# Maximum number of client IP keys tracked in memory before LRU eviction (positive integer, default: 10000)
RATE_LIMIT_MAX_KEYS=10000
