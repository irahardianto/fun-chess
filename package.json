{
  "name": "fun-chess",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "apps/server",
    "apps/client",
    "apps/e2e"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "pnpm --filter @fun-chess/server start",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @fun-chess/shared exec tsc --noEmit && pnpm --filter @fun-chess/server exec tsc --noEmit && pnpm --filter @fun-chess/client exec vue-tsc --noEmit && pnpm --filter @fun-chess/e2e run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm --filter @fun-chess/shared test && pnpm --filter @fun-chess/server exec vitest run --exclude '**/integration/**' && pnpm --filter @fun-chess/client test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "test:integration": "vitest run --config vitest.config.ts",
    "test:contracts": "vitest run apps/server/src/__tests__/integration/contracts",
    "test:e2e": "pnpm --filter @fun-chess/e2e test",
    "dev": "pnpm --filter @fun-chess/shared build && (pnpm --filter @fun-chess/server dev & pnpm --filter @fun-chess/client dev)",
    "dev:client": "pnpm --filter @fun-chess/client dev",
    "dev:server": "pnpm --filter @fun-chess/server dev"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "3.2.7",
    "vue-eslint-parser": "^10.4.1"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3",
      "vitest": "3.2.7"
    }
  }
}
